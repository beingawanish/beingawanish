{
  "type": "record",
  "name": "OrderConfirmed",
  "namespace": "com.edacommerce.order",
  "doc": "Stock is committed, payment is authorised and the warehouse has been asked to fulfil.",
  "fields": [
    {
      "name": "envelope",
      "type": "com.edacommerce.common.Envelope",
      "doc": "Shared metadata. Always the first field."
    },
    {
      "name": "orderId",
      "type": "string"
    },
    {
      "name": "reservationId",
      "type": "string"
    },
    {
      "name": "paymentId",
      "type": "string"
    },
    {
      "name": "fulfilmentId",
      "type": "string"
    },
    {
      "name": "confirmedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
