{
  "type": "record",
  "name": "CheckoutSubmitted",
  "namespace": "com.edacommerce.checkout",
  "doc": "A customer pressed 'Place order' and the checkout passed validation. Starts the order saga. The orderId is minted here so the HTTP response can return it at once.",
  "fields": [
    {
      "name": "envelope",
      "type": {
        "type": "record",
        "name": "Envelope",
        "namespace": "com.edacommerce.common",
        "doc": "Metadata carried by every event and command. The same values are mirrored into Kafka headers (see docs/implementation-guide.md) so that routers and tracing can read them without deserialising the body.",
        "fields": [
          {
            "name": "eventId",
            "type": "string",
            "doc": "UUIDv7 of this message. Primary key of the producer's outbox row and of every consumer's inbox row."
          },
          {
            "name": "type",
            "type": "string",
            "doc": "Fully qualified Avro record name, e.g. com.edacommerce.order.OrderPlaced."
          },
          {
            "name": "version",
            "type": "int",
            "doc": "Major version of the message contract. Matches the .vN suffix of the topic.",
            "default": 1
          },
          {
            "name": "occurredAt",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            },
            "doc": "When the fact happened in the producing service (UTC). Used to compute event age."
          },
          {
            "name": "correlationId",
            "type": "string",
            "doc": "Identifier of the whole business flow. For the order flow it is the orderId; for returns it is the returnId."
          },
          {
            "name": "causationId",
            "type": [
              "null",
              "string"
            ],
            "doc": "eventId of the message that caused this one. Null only for messages started by an HTTP request or a timer.",
            "default": null
          },
          {
            "name": "traceparent",
            "type": [
              "null",
              "string"
            ],
            "doc": "W3C trace context of the producing span.",
            "default": null
          },
          {
            "name": "tracestate",
            "type": [
              "null",
              "string"
            ],
            "doc": "W3C tracestate, if any.",
            "default": null
          },
          {
            "name": "producer",
            "type": "string",
            "doc": "Logical service name, e.g. order-svc. Not the language or the host."
          },
          {
            "name": "partitionKey",
            "type": "string",
            "doc": "The Kafka record key this message was published with. Copied here so that the key survives re-publication to retry and DLQ topics."
          },
          {
            "name": "aggregateType",
            "type": "string",
            "doc": "Aggregate that emitted the event, e.g. Order, Payment, Reservation."
          },
          {
            "name": "aggregateId",
            "type": "string",
            "doc": "Identifier of that aggregate instance."
          },
          {
            "name": "aggregateVersion",
            "type": "long",
            "doc": "Monotonic version of the aggregate after this change. Read models discard anything at or below the version they already hold.",
            "default": 0
          },
          {
            "name": "tenantId",
            "type": [
              "null",
              "string"
            ],
            "doc": "Reserved for multi-tenant reuse of the template. Null in the single-tenant shop.",
            "default": null
          },
          {
            "name": "expiresAt",
            "type": [
              "null",
              {
                "type": "long",
                "logicalType": "timestamp-millis"
              }
            ],
            "doc": "Commands only: a consumer that receives the command after this instant must reply with a rejection instead of acting on it.",
            "default": null
          }
        ]
      },
      "doc": "Shared metadata. Always the first field."
    },
    {
      "name": "checkoutId",
      "type": "string"
    },
    {
      "name": "orderId",
      "type": "string",
      "doc": "UUIDv7 minted by checkout. Partition key of the whole order flow."
    },
    {
      "name": "cartId",
      "type": "string"
    },
    {
      "name": "customerId",
      "type": "string"
    },
    {
      "name": "lines",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "LineItem",
          "namespace": "com.edacommerce.common",
          "doc": "One priced order line, frozen at checkout time.",
          "fields": [
            {
              "name": "lineId",
              "type": "string",
              "doc": "Stable identifier of the line within the order."
            },
            {
              "name": "sku",
              "type": "string"
            },
            {
              "name": "productName",
              "type": "string",
              "doc": "Name at time of purchase, for invoices and emails."
            },
            {
              "name": "quantity",
              "type": "int"
            },
            {
              "name": "unitPrice",
              "type": {
                "type": "record",
                "name": "Money",
                "namespace": "com.edacommerce.common",
                "doc": "An amount in minor units (cents, pence). Never a float, never an Avro decimal: integer minor units are identical in every language.",
                "fields": [
                  {
                    "name": "amountMinor",
                    "type": "long",
                    "doc": "Amount in the currency's minor unit. 1999 with EUR means 19.99 EUR."
                  },
                  {
                    "name": "currency",
                    "type": "string",
                    "doc": "ISO 4217 alphabetic code, upper case."
                  }
                ]
              }
            },
            {
              "name": "lineTotal",
              "type": "com.edacommerce.common.Money"
            }
          ]
        }
      }
    },
    {
      "name": "subtotal",
      "type": "com.edacommerce.common.Money"
    },
    {
      "name": "shippingFee",
      "type": "com.edacommerce.common.Money"
    },
    {
      "name": "tax",
      "type": "com.edacommerce.common.Money"
    },
    {
      "name": "total",
      "type": "com.edacommerce.common.Money"
    },
    {
      "name": "shippingAddress",
      "type": {
        "type": "record",
        "name": "Address",
        "namespace": "com.edacommerce.common",
        "doc": "A postal address. Personal data: every field that uses this type is tagged pii=true.",
        "fields": [
          {
            "name": "recipientName",
            "type": "string"
          },
          {
            "name": "line1",
            "type": "string"
          },
          {
            "name": "line2",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "city",
            "type": "string"
          },
          {
            "name": "region",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "postalCode",
            "type": "string"
          },
          {
            "name": "countryCode",
            "type": "string",
            "doc": "ISO 3166-1 alpha-2."
          },
          {
            "name": "phone",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      },
      "pii": true
    },
    {
      "name": "contactEmail",
      "type": "string",
      "pii": true
    },
    {
      "name": "shippingMethod",
      "type": {
        "type": "enum",
        "name": "ShippingMethod",
        "namespace": "com.edacommerce.common",
        "doc": "Delivery speed chosen at checkout. UNKNOWN is the reader default so that new symbols added by a producer do not break old consumers.",
        "symbols": [
          "STANDARD",
          "EXPRESS",
          "UNKNOWN"
        ],
        "default": "UNKNOWN"
      }
    },
    {
      "name": "paymentMethodToken",
      "type": "string",
      "doc": "Opaque token from the PSP's client-side tokenisation. Never a card number."
    },
    {
      "name": "priceSnapshotAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Time of the catalog read model state used to price the cart."
    }
  ]
}
