            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (consumer_group, outcome) (rate(eda_consumer_processed_total{consumer_group=~\"$group\"}[5m]))",
          "legendFormat": "{{consumer_group}} {{outcome}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Retries and dead letters",
