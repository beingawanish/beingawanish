            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, consumer_group) (rate(eda_event_age_seconds_bucket{consumer_group=~\"$group\"}[5m])))",
          "legendFormat": "p50 {{consumer_group}}",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, consumer_group) (rate(eda_event_age_seconds_bucket{consumer_group=~\"$group\"}[5m])))",
          "legendFormat": "p99 {{consumer_group}}",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Messages processed by outcome",
      "id": 9,
      "description": "outcome = success | duplicate | ignored | retry | dlq. A rising duplicate rate is normal under chaos; a rising dlq rate is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
