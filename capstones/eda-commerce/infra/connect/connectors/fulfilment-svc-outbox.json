{
  "name": "fulfilment-svc-outbox",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "debezium",
    "database.password": "debezium",
    "database.dbname": "fulfilment_db",
    "topic.prefix": "cdc.fulfilment",
    "plugin.name": "pgoutput",
    "slot.name": "fulfilment_svc_outbox",
    "publication.name": "outbox_pub",
    "publication.autocreate.mode": "disabled",
    "table.include.list": "public.outbox",
    "snapshot.mode": "initial",
    "tombstones.on.delete": "false",
    "binary.handling.mode": "bytes",
    "heartbeat.interval.ms": "10000",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.debezium.converters.BinaryDataConverter",
    "value.converter.delegate.converter.type": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.delegate.converter.type.schemas.enable": "false",
    "header.converter": "org.apache.kafka.connect.storage.SimpleHeaderConverter",
    "transforms": "outbox,specversion",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.expand.json.payload": "false",
    "transforms.outbox.route.by.field": "topic",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.fields.additional.placement": "id:header:ce_id,event_type:header:ce_type,producer:header:ce_source,occurred_at:header:ce_time,correlation_id:header:correlation_id,causation_id:header:causation_id,traceparent:header:traceparent,tracestate:header:tracestate",
    "transforms.specversion.type": "org.apache.kafka.connect.transforms.InsertHeader",
    "transforms.specversion.header": "ce_specversion",
    "transforms.specversion.value.literal": "1.0",
    "producer.override.acks": "all",
    "producer.override.enable.idempotence": "true",
    "producer.override.compression.type": "zstd",
    "producer.override.linger.ms": "5",
    "errors.tolerance": "none",
    "errors.log.enable": "true",
    "errors.log.include.messages": "false"
  }
}
